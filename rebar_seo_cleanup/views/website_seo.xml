<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="noindex_odoo_public_pages" inherit_id="website.layout" name="Noindex Odoo public pages">
        <xpath expr="//head" position="inside">
            <meta name="robots" content="noindex,follow"/>
        </xpath>
    </template>
</odoo>
