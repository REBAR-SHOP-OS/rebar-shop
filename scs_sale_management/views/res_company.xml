<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Company Form View Extension -->
    <record id="view_company_form_inherit_delete_restriction" model="ir.ui.view">
        <field name="name">res.company.form.inherit.delete.restriction</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
            <page name="restricted_models" string="Restricted Models">
                <group name="restricted_models" string="Restricted Models To Delete">
                    <field name="restricted_models" widget="many2many_tags" />
                </group>
            </page>
            </xpath>
        </field>
    </record>

</odoo>